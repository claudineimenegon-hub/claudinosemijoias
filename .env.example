# Supabase - valores públicos usados no navegador
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=COLE_A_CHAVE_ANON_PUBLICA

# Supabase - segredo exclusivo das Netlify Functions
SUPABASE_SERVICE_ROLE_KEY=COLE_APENAS_NAS_VARIAVEIS_DA_NETLIFY

# Mercado Pago - manter somente nas variáveis protegidas da Netlify
MERCADO_PAGO_ACCESS_TOKEN=COLE_APENAS_NAS_VARIAVEIS_DA_NETLIFY

# A Public Key do Mercado Pago pode ser exposta ao navegador
MERCADO_PAGO_PUBLIC_KEY=COLE_A_PUBLIC_KEY
